# ── Appwrite ─────────────────────────────────────────────
APPWRITE_ENDPOINT="https://cloud.jagadeesh.site/v1"
APPWRITE_PROJECT_ID="6a54466d0020ab1a31ad"
APPWRITE_PROJECT_NAME="gym-management"
# Server API key — paste yours here (scopes: users, sessions, databases, tables, rows, columns, indexes)
APPWRITE_API_KEY=""
APPWRITE_DATABASE_ID="gymos"
# Appwrite Site that hosts this Next.js app (gym subdomains + custom domains are proxy rules pointing here)
APPWRITE_SITE_ID="gymos-web"
# Public (browser) values — used only for Realtime subscriptions with a short-lived JWT
NEXT_PUBLIC_APPWRITE_ENDPOINT="https://cloud.jagadeesh.site/v1"
NEXT_PUBLIC_APPWRITE_PROJECT_ID="6a54466d0020ab1a31ad"

# ── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="GymOS"
NEXT_PUBLIC_ROOT_DOMAIN="gym.avnix.in"
# Used to build absolute links in emails; set to https://gym.avnix.in in production
APP_URL="http://localhost:3000"
# 32+ byte secret for signing internal tokens (audit/unlock). Generated locally.
APP_SECRET=""
# Protects /api/cron/journeys (send as: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# ── Twilio (shared AvniX account — copied from RowDesk) ──
# Main account creds; each gym stores its own SMS Messaging Service SID + WhatsApp sender in the admin panel.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
TWILIO_EMAIL_FROM="noreply.gymos@avnix.in"
TWILIO_EMAIL_FROM_NAME="GymOS"

# ── Platform ─────────────────────────────────────────────
# Root domain that hosts the app; gym sites live at <slug>.<ROOT_DOMAIN>
ROOT_DOMAIN="gym.avnix.in"
# Comma-separated super-admin emails (can open /admin)
SUPER_ADMIN_EMAILS="jagadeeshp@theavni.studio"
# DNS targets shown to gym owners connecting a custom domain (your Appwrite server)
APPWRITE_DOMAIN_TARGET_CNAME="cloud.jagadeesh.site"
APPWRITE_DOMAIN_TARGET_A="147.93.170.241"
